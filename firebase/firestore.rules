rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && request.auth.token.role == 'admin'; }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || admin());
      allow update: if signedIn() && request.auth.uid == userId
        && request.resource.data.role == resource.data.role;
      allow create, delete: if admin();
    }

    match /connections/{connectionId} {
      allow read, write: if signedIn();
    }

    match /operationLogs/{logId} {
      allow read: if admin();
      allow create: if signedIn()
        && request.resource.data.actor.uid == request.auth.uid
        && request.resource.data.operation is string
        && request.resource.data.status in ['success', 'error']
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
